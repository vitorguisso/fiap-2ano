# CardioIA - Fase 5 - exemplo de configuracao
#
# COMO USAR:
#   1. copie este arquivo para .env  (o .env nao vai para o GitHub)
#   2. preencha com as credenciais da SUA instancia do watsonx Assistant
#
# Onde encontrar cada valor na IBM Cloud:
#   WATSON_API_KEY  -> pagina do servico watsonx Assistant > Service credentials > apikey
#   WATSON_URL      -> pagina do servico > Service credentials > url
#                      (ex.: https://api.us-south.assistant.watson.cloud.ibm.com/instances/xxxx)
#   WATSON_ASSISTANT_ID -> no Watson Assistant classico: Assistants > seu assistente >
#                          menu (tres pontos) > Settings > API Details > Assistant ID
#
# Se estas variaveis NAO forem preenchidas, o backend inicia em MODO LOCAL
# (NLU proprio, sem chamada a nuvem). Ver README, secao "Modo de demonstracao local".

WATSON_API_KEY=
WATSON_URL=
WATSON_ASSISTANT_ID=

# Versao da API do Watson Assistant (mesma usada no material didatico - Cap10)
WATSON_VERSION=2021-06-14

# Chave usada pelo Flask para assinar o cookie de sessao.
# Em producao seria um valor aleatorio e secreto.
FLASK_SECRET_KEY=cardioia-fase5-chave-de-desenvolvimento

# Porta do servidor local
PORT=5000
