    {
        "id": "f610f4bfa14b0aba",
        "type": "function",
        "z": "3e59534ee95f5b9a",
        "name": "function 3",
        "func": "let temperatura = Number(msg.payload.temperatura);\nlet bpm = Number(msg.payload.bpm);\n\nlet hipotermia = temperatura < 35;\nlet febre = temperatura >= 38;\nlet sinalAusente = bpm === 0;\nlet bradicardia = bpm > 0 && bpm < 50;\nlet taquicardia = bpm > 120;\n\nlet texto = \"Paciente normal\";\nlet cor = \"#00C853\"; // verde\n\n// ===== CRÍTICOS =====\nif (sinalAusente && hipotermia) {\n    texto = \"🚨 Hipotermia + Sem batimentos\";\n    cor = \"#D50000\";\n}\nelse if (sinalAusente && febre) {\n    texto = \"🚨 Febre + Sem batimentos\";\n    cor = \"#D50000\";\n}\nelse if (sinalAusente) {\n    texto = \"🚨 Sem batimentos\";\n    cor = \"#D50000\";\n}\nelse if (hipotermia && taquicardia) {\n    texto = \"🚨 Hipotermia + Taquicardia\";\n    cor = \"#D50000\";\n}\nelse if (febre && taquicardia) {\n    texto = \"🚨 Febre + Taquicardia\";\n    cor = \"#D50000\";\n}\nelse if (hipotermia && bradicardia) {\n    texto = \"🚨 Hipotermia + Bradicardia\";\n    cor = \"#D50000\";\n}\nelse if (febre && bradicardia) {\n    texto = \"🚨 Febre + Bradicardia\";\n    cor = \"#D50000\";\n}\n\n// ===== ALERTAS =====\nelse if (hipotermia) {\n    texto = \"❄️ Hipotermia\";\n    cor = \"#FFD600\";\n}\nelse if (febre) {\n    texto = \"🔥 Febre\";\n    cor = \"#FFD600\";\n}\nelse if (taquicardia) {\n    texto = \"⚠️ Taquicardia\";\n    cor = \"#FFD600\";\n}\nelse if (bradicardia) {\n    texto = \"⚠️ Bradicardia\";\n    cor = \"#FFD600\";\n}\n\n// ===== SAÍDA =====\nmsg.payload = texto;\n\n// 🔥 AQUI ESTÁ O SEGREDO\nmsg.ui_control = {\n    color: cor\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
